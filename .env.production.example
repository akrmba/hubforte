# .env.production.example
# Copy this to your CI/CD secrets or server environment.
# NEVER commit a filled-in version of this file.
# Every variable here must be set before starting the production stack.
# Variable names match exactly what the application code reads at runtime.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=production
PORT=3000

# Neon Postgres connection string (keep ?sslmode=require)
DATABASE_URL=postgresql://user:password@db.example.invalid/dbname?sslmode=require

# Generate with: openssl rand -base64 64
JWT_SECRET=
SESSION_SECRET=

# Generate with: openssl rand -base64 32
WORKER_SECRET=

# ---------------------------------------------------------------------------
# Admin seed (used only on first boot / db seed — change immediately after)
# scripts/src/seed.ts reads SEED_PASSWORD (falls back to "Admin123!" if unset)
# ---------------------------------------------------------------------------
ADMIN_EMAIL=admin@yourdomain.com
# REQUIRED — Set a strong unique password. Never ship a default.
SEED_PASSWORD=

# ---------------------------------------------------------------------------
# URLs & CORS
# ---------------------------------------------------------------------------
# Public URL of the CRM frontend (used for password-reset links)
FRONTEND_URL=https://crm.yourdomain.com

# Comma-separated list of allowed CORS origins (app.ts reads ALLOWED_ORIGINS)
ALLOWED_ORIGINS=https://crm.yourdomain.com,https://lms.yourdomain.com

# Public URL of the API (used by the worker to call back)
APP_URL=https://api.yourdomain.com

# ---------------------------------------------------------------------------
# Gmail OAuth (for outreach email sending)
# ---------------------------------------------------------------------------
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=https://api.yourdomain.com/api/auth/gmail/callback
GMAIL_REFRESH_TOKEN=
GMAIL_FROM_ADDRESS=           # The "from" address for system emails e.g. noreply@yourdomain.com

# ---------------------------------------------------------------------------
# AI — System (owner/platform workflows)
# aiModels.ts reads AI_DEFAULT_PROVIDER and AI_DEFAULT_MODEL
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

AI_DEFAULT_PROVIDER=anthropic
AI_DEFAULT_MODEL=claude-sonnet-4-6

# ---------------------------------------------------------------------------
# AI — Client-facing features
# aiProvider.ts reads DEFAULT_CLIENT_AI_PROVIDER and DEFAULT_CLIENT_AI_MODEL
# ---------------------------------------------------------------------------
DEFAULT_CLIENT_AI_PROVIDER=openrouter
DEFAULT_CLIENT_AI_MODEL=deepseek/deepseek-chat

# ---------------------------------------------------------------------------
# Incident Detection & Alerting (Phase 7B)
# incidentNotifier.ts reads SUPER_ADMIN_EMAIL and SEND_CLIENT_INCIDENT_EMAILS
# ---------------------------------------------------------------------------
SUPER_ADMIN_EMAIL=ops@yourdomain.com
SLACK_WEBHOOK_URL=
STATUS_PAGE_API_KEY=
STATUS_PAGE_ID=
STATUS_PAGE_URL=https://status.yourdomain.com
# Set to "true" only when confident in incident detection accuracy
SEND_CLIENT_INCIDENT_EMAILS=true

# ---------------------------------------------------------------------------
# Integrations encryption (Phase 9A)
# ---------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRATION_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Instatus (Phase 9C)
# ---------------------------------------------------------------------------
INSTATUS_API_KEY=
INSTATUS_PAGE_ID=

# ---------------------------------------------------------------------------
# Emergency break-glass access (Phase 0C)
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
# Store in password manager — not in the repo
EMERGENCY_ACTIVATION_TOKEN=

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------
POLL_INTERVAL_SECONDS=60

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Backup destination (optional)
# ---------------------------------------------------------------------------
# BACKUP_DESTINATION=s3://my-bucket/hubforte-backups
