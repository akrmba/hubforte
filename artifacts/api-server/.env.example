# PostgreSQL connection string (Neon recommended)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Secret used to sign JWT tokens — generate with: openssl rand -base64 64
JWT_SECRET=

# Secret used for session encryption — generate with: openssl rand -base64 64
SESSION_SECRET=

# Environment: development | production
NODE_ENV=development

# Port the API server listens on
PORT=3000

# Shared secret between the campaign worker and the API — generate with: openssl rand -base64 32
WORKER_SECRET=

# Gmail OAuth credentials (from Google Cloud Console)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3000/api/gmail/callback
GMAIL_FROM_ADDRESS=

# ---------------------------------------------------------------------------
# Phase 10 — AI Layer
# ---------------------------------------------------------------------------

# System AI — used for owner/platform workflows (health dashboard, error explanations,
# remediation, daily briefing). Defaults to Anthropic (Claude).
SYSTEM_AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# OpenAI API key (optional — fallback for system AI or tenant BYOK)
OPENAI_API_KEY=

# Default Client AI — used for tenant-facing features (email composer, lead scoring,
# contact summary, next best action) when a tenant has no BYOK config.
# Defaults to OpenRouter + DeepSeek V3 (~$0.27/million tokens).
DEFAULT_CLIENT_AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
DEFAULT_CLIENT_AI_MODEL=deepseek/deepseek-chat

# Legacy single-provider config (still respected as fallback)
AI_DEFAULT_PROVIDER=openrouter
AI_DEFAULT_MODEL=deepseek/deepseek-chat

# Admin email used for seeding the initial admin user
ADMIN_EMAIL=admin@example.com

# REQUIRED — Set a strong unique password before running seed
SEED_PASSWORD=

# Frontend URL for password reset links and CORS
APP_URL=http://localhost:5173

# Comma-separated list of allowed CORS origins (production frontend URLs)
# Example: https://your-app.example.com,https://staging.example.com
ALLOWED_ORIGINS=

# Backup destination — local path or S3 URL
# Examples: ./backups  |  s3://my-bucket/hubforte-backups
BACKUP_DEST=./backups

# Google OAuth (used for Gmail integration alternative flow)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth callback URL (if NextAuth is used in future)
NEXTAUTH_URL=

# Frontend application URL (used for CORS and redirect links)
FRONTEND_URL=

# Gmail refresh token for server-side Gmail access without OAuth flow
GMAIL_REFRESH_TOKEN=

# Log level: error, warn, info, debug (default: info)
LOG_LEVEL=

# Break-glass emergency access token — generate with: openssl rand -base64 32
# Used by POST /api/super-admin/emergency-access/activate to unlock the emergency account.
# Keep this secret and store it somewhere safe (password manager, not in the repo).
# Leave blank to disable emergency access entirely.
EMERGENCY_ACTIVATION_TOKEN=

# ---------------------------------------------------------------------------
# Phase 7B — Incident Detection & Alerting
# ---------------------------------------------------------------------------

# Email address to receive P1/P2 incident alerts (owner/ops email)
SUPER_ADMIN_EMAIL=

# Slack webhook URL for incident notifications (optional — leave blank to disable)
SLACK_WEBHOOK_URL=

# Instatus/Statuspage API key for automatic status page updates (optional)
STATUS_PAGE_API_KEY=
# Instatus page ID (required if STATUS_PAGE_API_KEY is set)
STATUS_PAGE_ID=
# Public status page URL shown in client incident emails
STATUS_PAGE_URL=

# Set to true to send incident notification emails to affected tenant admins.
# Default: false — enable only when confident in incident detection accuracy.
SEND_CLIENT_INCIDENT_EMAILS=false

# ---------------------------------------------------------------------------
# Phase 9A/9B — Webhook Framework & Integrations
# ---------------------------------------------------------------------------

# AES-256 encryption key for integration connector credentials (required for integrations)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRATION_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Phase 9B — Pre-built Connectors
# ---------------------------------------------------------------------------

# SendGrid (optional — if configured, outreach emails use SendGrid instead of Gmail)
# Configure via the Integrations page in the CRM UI (stored encrypted in DB)

# Slack connector (optional — tenant-specific Slack notifications)
# Configure via the Integrations page in the CRM UI (stored encrypted in DB)

# ---------------------------------------------------------------------------
# Phase 9C — Public Status Page (Instatus)
# ---------------------------------------------------------------------------

# Instatus API key (optional — enables automatic status page incident management)
INSTATUS_API_KEY=
# Instatus page ID (required if INSTATUS_API_KEY is set)
INSTATUS_PAGE_ID=

# ---------------------------------------------------------------------------
# Import / Export safety limits
# ---------------------------------------------------------------------------

# MAX_IMPORT_ROWS: Maximum rows allowed per import job (default 5000)
MAX_IMPORT_ROWS=5000

# MAX_EXPORT_WARNING_ROWS: Rows above this threshold show a "may take time" warning (default 10000)
MAX_EXPORT_WARNING_ROWS=10000
