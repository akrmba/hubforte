# Worker .env configuration
# For full secrets and environment variable documentation, see docs/SECRETS_SOURCE_OF_TRUTH.md
# This file lists tracked secret examples; copy to .env and fill in real values for local development.

# The production app URL — worker calls this to trigger campaign processing
APP_URL=https://your-app.replit.app

# Secret shared between the worker and the app. Must match WORKER_SECRET in app.
WORKER_SECRET=your-secret-here

# How often (in seconds) the worker polls for pending campaigns. Default: 60
POLL_INTERVAL_SECONDS=60

# The worker has no direct database access.
# It communicates exclusively via the app's API.
