{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "workspace": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "workspace": "./src/schema/index.ts",
      "default": "./src/schema/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "push": "echo 'ERROR: drizzle-kit push is blocked. Use SQL migration files in lib/db/migrations/ instead. See docs/SCHEMA_SOURCE_OF_TRUTH.md' && exit 1",
    "push-force": "echo 'ERROR: drizzle-kit push is blocked. Use SQL migration files in lib/db/migrations/ instead. See docs/SCHEMA_SOURCE_OF_TRUTH.md' && exit 1",
    "migrate": "echo 'Apply migrations via: psql $DATABASE_URL -f lib/db/migrations/XXXX_description_up.sql'"
  },
  "dependencies": {
    "dotenv": "^16.0.0",
    "drizzle-orm": "^0.45.1",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.20.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "@types/pg": "^8.18.0",
    "drizzle-kit": "^0.31.10"
  }
}
